# threat_watch configuration
#
# One file per cPanel account (instance). install.sh copies this file to
# /etc/threat_watch/<account>.conf and fills in __ACCOUNT__.
#
# Syntax: KEY="value"  (one per line, # starts a comment)
# Check after editing:  threat_watch.sh -c /etc/threat_watch/<account>.conf --validate
# Unknown keys are reported and ignored, so typos show up in --validate.

# ---------------------------------------------------------------------------
# Instance
# ---------------------------------------------------------------------------

# Name used for the state folder (STATE_DIR/<INSTANCE_NAME>) and in reports.
INSTANCE_NAME="__ACCOUNT__"

# ---------------------------------------------------------------------------
# Countries  (ISO 3166 two-letter codes: ID=Indonesia, MY=Malaysia, GM=Gambia,
#             SG=Singapore, CN=China, RU=Russia, US=United States, ...)
# ---------------------------------------------------------------------------

# Countries to analyse. Visitors from other countries are only counted.
# Use "ALL" to analyse every country (uses more memory for the country table).
WATCH_COUNTRIES="ID"

# Also analyse IPs whose country is unknown (not found in the table).
WATCH_UNKNOWN="no"

# Never analyse or report these countries, even if listed in WATCH_COUNTRIES.
WHITELIST_COUNTRIES="MY"

# Never analyse or report these IPs / networks (your office, monitoring, the
# server itself). Space separated. IPv4 and IPv6 both work.
WHITELIST_IPS="127.0.0.1 ::1"
WHITELIST_CIDRS=""

# ---------------------------------------------------------------------------
# Input logs
# ---------------------------------------------------------------------------

# Live Apache domlogs for the account (owned by root, so not tamperable).
DOMLOG_DIR="/usr/local/apache/domlogs/__ACCOUNT__"

# Only read log files matching this glob (default: all).
LOG_GLOB="*"

# Limit to these domains (space separated, empty = every domain in DOMLOG_DIR).
# A domain covers both its HTTP log and its -ssl_log.
DOMAINS=""

# Never read files matching these globs.
EXCLUDE_LOGS="*-bytes_log *-ftp_log *.bkup *.offset *.gz"

# Where cPanel archives rotated logs (<log>-Mon-YYYY.gz). When a live log is
# rotated between two runs, the lines written before rotation are read from
# here so nothing is missed. Leave empty to disable.
ARCHIVE_DIR="/home/__ACCOUNT__/logs"
ROTATION_CATCHUP="yes"

# Safety cap on how much decompressed data one archive catch-up may read.
ARCHIVE_MAX_MB="1024"

# First run with no saved position: "full" = analyse what is in the live logs
# now, "skip" = start from the end and only analyse new traffic.
FIRST_RUN="full"

# Longer log lines are cut to this many bytes.
MAX_LINE_LENGTH="8192"

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

# Reports go here. The folder is created owned by root, mode 0700. If it
# already exists and is owned by another user, threat_watch refuses to run
# (the account user could otherwise tamper with files root writes).
OUTPUT_DIR="/home/__ACCOUNT__/logs/threat_watch"

# Positions, country table and repeat-offender history (root only).
# The real folder is STATE_DIR/INSTANCE_NAME.
STATE_DIR="/var/lib/threat_watch"

# Permissions for report files (must not be group/world writable).
OUTPUT_FILE_MODE="0600"

# Delete per-run reports older than this many days.
RETENTION_DAYS="30"

# Per suspicious IP: how many example log lines to keep in the details file.
SAMPLE_LINES_PER_IP="30"

# How many of the busiest normal visitors to list in the summary (0 = none).
TOP_NORMAL="20"

# Forget an IP in repeat_offenders.txt after this many days without activity.
REPEAT_KEEP_DAYS="90"

# ---------------------------------------------------------------------------
# Country lookup
# ---------------------------------------------------------------------------

# "rir"  = build the table from the official RIR delegation files (no extra
#          software; downloaded every GEO_REFRESH_DAYS days, about 30-60 MB
#          transferred, stored as one ~10 MB file in STATE_DIR).
# "mmdb" = use a MaxMind/DB-IP .mmdb file through the mmdblookup command.
GEO_PROVIDER="rir"
GEO_REFRESH_DAYS="7"
RIR_SOURCES="https://ftp.apnic.net/stats/apnic/delegated-apnic-latest https://ftp.ripe.net/pub/stats/ripencc/delegated-ripencc-latest https://ftp.arin.net/pub/stats/arin/delegated-arin-extended-latest https://ftp.afrinic.net/pub/stats/afrinic/delegated-afrinic-latest https://ftp.lacnic.net/pub/stats/lacnic/delegated-lacnic-latest"
GEO_MMDB_FILE=""

# ---------------------------------------------------------------------------
# Classification
# ---------------------------------------------------------------------------

# Shipped rules (replaced on upgrade). Empty = <install dir>/rules.
RULES_DIR=""

# Your own rules, kept across upgrades. Same file names as the shipped ones
# (attack.rules, scanner.rules, scanner_ua.rules, bot_ua.rules). A rule with
# the same name as a shipped rule replaces it.
LOCAL_RULES_DIR="/etc/threat_watch/rules.local"

# Turn off shipped rules by name, e.g. "wordpress_probe http_library".
DISABLED_RULES=""

# A visitor with at least this many 404s on .php URLs in one run is a scanner
# (0 = off).
SCANNER_404_THRESHOLD="20"

# Real Googlebot/Bingbot/... crawl from a few countries. The same user-agent
# from a watched country (and not in FAKE_BOT_EXEMPT_COUNTRIES) is reported
# as fake_bot.
FLAG_FAKE_BOTS="yes"
FAKE_BOT_UA_REGEX="googlebot|bingbot|applebot|duckduckbot|yandexbot|baiduspider"
FAKE_BOT_EXEMPT_COUNTRIES="US"
