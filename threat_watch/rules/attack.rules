# threat_watch - ATTACK rules
#
# Format: <rule_name> <regex>
#   - matched case-insensitively against "METHOD URL",
#     e.g. "POST /index.php?option=com_jce&task=plugin.display"
#   - rules are checked top to bottom; the first match wins
#   - attack rules are checked before scanner and bot rules
#
# Tuning (survives upgrades):
#   - disable a rule:  DISABLED_RULES="rule_name other_rule" in the config
#   - change a rule:   add a rule with the SAME name in LOCAL_RULES_DIR/attack.rules
#   - add a rule:      add a new name in LOCAL_RULES_DIR/attack.rules

# --- upload exploits seen in the wild (Nov 2026) ----------------------------
jce_upload          ^POST\s+/(?:index\.php)?\?(?:\S*&)?option=com_jce\b
jce_profile_import  [?&]option=com_jce\S*[?&]task=profiles\.import

# --- PHP executed from folders that should only hold data ------------------
php_in_tmp          ^\S+\s+/(?:administrator/)?(?:tmp|cache|logs)/[^?\s]*\.(?:php\d?|phtml|pht|phar|shtml)\b
tmp_file_access     ^\S+\s+/(?:administrator/)?tmp/(?!index\.html?(?:[?\s]|$))[^?\s]+
php_in_uploads      ^\S+\s+/(?:images|media|uploads|files)/[^?\s]*\.(?:php\d?|phtml|pht|phar)\b
image_query_php     \.(?:png|jpe?g|gif|ico|webp|bmp|svg|txt)(?:\?|%3f)\.(?:php\d?|phtml)\b
image_hash_file     \.(?:png|jpe?g|gif|ico|webp)(?:#|%23)\S*\.(?:txt|php\d?)\b

# --- known webshell / file-manager names -----------------------------------
webshell_name       /(?:wso|alfa|alfacgiapi|c99|r57|b374k|marijuana|indoxploit|shell|mini|mini_[0-9a-f]{4,}|kdkd|kekeke|oke+_|nass|xa|a5|cyph_[0-9a-f]{4,}|yoru_[0-9a-f]{4,}|xml_[0-9a-f]{6,}|wp-setting|wp-fguage|wp-comment)\.(?:php\d?|phtml)\b
filemanager_shell   (?:den1xxx|tinyfilemanager\.php)
root_admin_php      ^\S+\s+/admin\.php\b

# --- injection payloads in the URL -----------------------------------------
code_injection      (?:eval|assert|base64_decode|gzinflate|str_rot13|system|passthru|shell_exec|proc_open|popen)(?:\(|%28)
php_wrapper         (?:php://(?:input|filter)|data://text|expect://|phar://)
path_traversal      (?:\.\./|\.\.%2f|%2e%2e/|%2e%2e%2f){2,}
sql_injection       (?:union(?:\s|%20|\+|/\*\*/)+(?:all(?:\s|%20|\+)+)?select|sleep(?:\(|%28)\d|benchmark(?:\(|%28)|information_schema)
log4shell           \$(?:\{|%7b)jndi:
