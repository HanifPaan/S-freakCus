# threat_watch - SCANNER rules (probing / fingerprinting)
#
# Format: <rule_name> <regex>, matched case-insensitively against "METHOD URL".
# Checked after attack rules. See attack.rules for how to tune.
#
# NOTE: wordpress_probe assumes the sites are NOT WordPress. If a domain in
# this account runs WordPress, add  DISABLED_RULES="wordpress_probe"  in the config.

hidden_files        /\.(?:git|svn|hg|env|aws|ssh|DS_Store|htpasswd|vscode)(?:/|\?|\s|$)
wordpress_probe     /(?:wp-login\.php|wp-admin/|xmlrpc\.php|wp-content/|wp-includes/|wp-json/)
cms_fingerprint     /(?:plugins/editors/jce/jce\.xml|administrator/manifests/files/joomla\.xml|language/en-GB/en-GB\.xml|administrator/language/en-GB/en-GB\.xml)
config_leak         /(?:configuration|wp-config|config|settings|database)\.php(?:~|\.bak|\.old|\.orig|\.save|\.txt|\.swp|\.dist)
backup_probe        /[^?\s/]*\.(?:sql|sql\.gz|bak|old|swp|tar|tar\.gz|tgz|7z|rar)(?:\?|\s|$)
db_admin_probe      /(?:phpmyadmin|pma|myadmin|dbadmin|mysqladmin|adminer(?:-[\d.]+)?\.php)
phpunit_probe       /vendor/phpunit/
device_exploit      /(?:boaform|HNAP1|cgi-bin/|actuator/|solr/|GponForm|setup\.cgi)
admin_login_post    ^POST\s+/administrator/(?:index\.php)?(?:\?|\s|$)
