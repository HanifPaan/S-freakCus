# threat_watch - BOT user-agent rules
#
# Format: <bot_name> <regex>, matched case-insensitively against the User-Agent.
# The rule name is what appears in the BOTS table of the summary.
#
# If FLAG_FAKE_BOTS=yes and the user-agent also matches FAKE_BOT_UA_REGEX
# (Googlebot, Bingbot, ...) while the visitor's country is not in
# FAKE_BOT_EXEMPT_COUNTRIES, the visitor is reported as fake_bot instead.

googlebot           googlebot|google-inspectiontool|googleother|storebot-google|adsbot-google|mediapartners-google
bingbot             bingbot|msnbot|bingpreview
applebot            applebot
yandex              yandex(?:bot|images|mobilebot|metrika)
baidu               baiduspider
duckduckgo          duckduckbot|duckassistbot
semrush             semrushbot
ahrefs              ahrefsbot
majestic            mj12bot
dotbot              dotbot
petalbot            petalbot
bytespider          bytespider
openai              gptbot|oai-searchbot|chatgpt-user
anthropic           claudebot|claude-user|claude-searchbot
commoncrawl         ccbot
meta                facebookexternalhit|meta-externalagent|facebookbot
telegram            telegrambot
twitter             twitterbot
whatsapp            whatsapp
linkedin            linkedinbot
amazon              amazonbot
generic_bot         (?:bot|crawler|spider|crawl)\b
